# Research pipeline: generated intermediates + re-run outputs.
# All regenerated by build_panel.py -> ablation.py; several exceed GitHub's
# 100MB file limit (data_proc_wide/dataset.parquet is ~609MB).
# research/results/ is NOT ignored - it is the archived record of record.
research/data_proc/
research/data_proc_wide/
research/data_raw_wide/
research/out/

# Jupyter
.ipynb_checkpoints/

# pytest
.pytest_cache/
.coverage
htmlcov/
